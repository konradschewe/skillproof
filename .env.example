# For Anthropic provider
ANTHROPIC_API_KEY=your-api-key-here

# For AI Core provider
# AICORE_SERVICE_KEY is read directly by @sap-ai-sdk and must contain the full
# service key JSON from BTP (clientid, clientsecret, url, tokenurl).
# AICORE_SERVICE_KEY={"clientid":"...","clientsecret":"...","url":"...","tokenurl":"..."}
#
# AICORE_RESOURCE_GROUP is optional (default: "default").
# It is read by skillproof and passed to the AI Core client.
# AICORE_RESOURCE_GROUP=default
