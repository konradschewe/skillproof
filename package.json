{
  "name": "@skillproof/cli",
  "version": "0.0.0-development",
  "description": "Verify that Claude agent skills are correctly adopted in your codebase",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/konradschewe/skillproof.git"
  },
  "bin": {
    "skillproof": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test:manual": "bash test/manual/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@langchain/anthropic": "^1.5.4",
    "@langchain/core": "^1.2.5",
    "@langchain/mcp-adapters": "^1.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server-filesystem": "^2026.7.10",
    "@sap-ai-sdk/langchain": "2.10.0",
    "commander": "^14.0.0",
    "glob": "^11.0.0",
    "langchain": "^1.5.5",
    "tokenlens": "^1.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "24.12.0",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "rimraf": "6.1.3",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
